<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}JOURNAL - Mobile{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
        <script src="https://code.jquery.com/jquery-3.6.1.slim.min.js" integrity="sha256-w8CvhFs7iHNVUtnSP0YKEg00p9Ih13rlL9zGqvLdePA=" crossorigin="anonymous"></script>
        <style>
            .xsm {
                padding: .2rem .5rem;
                font-size: .5em;
                border-radius: .25rem;
            }
            .mobile-card {
                border: 1px solid #dee2e6;
                border-radius: 0.25rem;
                padding: 10px;
                margin-bottom: 10px;
                background-color: #fff;
            }
            .mobile-card .time-row {
                display: flex;
                justify-content: space-between;
                font-size: 0.9em;
                color: #6c757d;
            }
            .mobile-card .customer-row {
                font-weight: bold;
                margin-top: 5px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .mobile-card .note-row {
                margin-top: 5px;
                border-top: 1px dashed #dee2e6;
                padding-top: 5px;
            }
            .mobile-card .actions {
                margin-top: 10px;
                display: flex;
                gap: 5px;
                justify-content: flex-end;
            }

            .mobile-card .btn {
                padding: 5px;
                line-height: 0.7;
            }
        </style>
    </head>
    <body>
        <div class="container">
{#            {% if db == 'prod.db' %}<div class="alert alert-success my-1 text-center small p-1"><strong>PRODUCTION</strong></div>{% endif %}#}
            {% if db == 'dev.db' %}<div class="alert alert-danger my-1 text-center small p-1"><strong>DEVELOPMENT</strong></div>{% endif %}
            <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                <div>
                    <a href="{{ path('journal', {'entries': 'today'}) }}" class="btn {{ current_entries == 'today' ? 'btn-success' : 'btn-outline-success' }} btn-sm">Today</a>
                    <a href="{{ path('journal', {'entries': 'last'}) }}" class="btn {{ current_entries == 'last' ? 'btn-primary' : 'btn-outline-primary' }} btn-sm">Open</a>
                    <a href="{{ path('journal', {'entries': 'archived'}) }}" class="btn {{ current_entries == 'archived' ? 'btn-warning' : 'btn-outline-warning' }} btn-sm">All</a>
                </div>
                <div>
                    <a href="{{ path('journal') }}" class="btn btn-primary btn-sm mx-1">Journal</a>
                    <a href="{{ path('todo.list', {'status': 'open'}) }}" class="btn btn-outline-primary btn-sm mx-1">Todos</a>
                </div>
                <div>
                    <a href="{{ app.request.requestUri ~ (app.request.requestUri matches '/\\?/' ? '&' : '?') ~ 'view=desktop' }}" class="btn btn-outline-secondary btn-sm">Desktop</a>
                </div>
            </div>
            <div class="card p-3 my-3">
                {{ form_start(journal_entry_form, { 'action': app.request.requestUri }) }}
                    {% if journal_entry_form.timestamp is defined %}
                        <div class="row">
                            <div class="col-12">{{ form_row(journal_entry_form.timestamp) }}</div>
                        </div>
                    {% endif %}
                    <div class="row">
                        <div class="col-6">{{ form_row(journal_entry_form.startingTime) }}</div>
                        <div class="col-6">{{ form_row(journal_entry_form.endingTime) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-12">{{ form_row(journal_entry_form.customer) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-12">{{ form_row(journal_entry_form.note) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-12">{{ form_row(journal_entry_form.submit, {'attr': {'class': 'btn btn-primary w-100'}}) }}</div>
                    </div>
                {{ form_end(journal_entry_form) }}

                <div class="mt-3">
                    {% for entry in journal_entries %}
                        {% set difference = date(entry.endingTime).diff(date(entry.startingTime ? entry.startingTime : entry.endingTime)) %}
                        <div class="mobile-card">
                            <div class="time-row">
                                {% if current_entries != 'today' %}<span>{{ entry.timestamp.format('d.m.Y') }}</span>{% endif %}
                                <span>{{ entry.startingTime ? entry.startingTime.format('H:i') : '' }} - {{ entry.endingTime ? entry.endingTime.format('H:i') : '' }}</span>
                                <span>{{ difference.format('%h') }}.{{ (difference.format('%i') / 60 * 10)|round(2)|replace({'.':''}) }}h</span>
                            </div>
                            <div class="customer-row">
                                <div>{{ entry.customer }}</div>
                                <div>
                                    <a href="{{ path('entry.edit', {'id': entry.id, 'entries': current_entries}) }}" class="btn btn-warning btn-sm">EDIT</a>
                                    <a href="{{ path('entry.archive', {'id': entry.id, 'entries': current_entries}) }}" class="btn btn-success btn-sm">&check;</a>
                                </div>
                            </div>
                            <div class="note-row">
                                {{ entry.note }}
                            </div>
{#                            <div class="actions">#}
{#                                <a href="{{ path('entry.edit', {'id': entry.id, 'entries': current_entries}) }}" class="btn btn-warning btn-sm">EDIT</a>#}
{#                                <a href="{{ path('entry.archive', {'id': entry.id, 'entries': current_entries}) }}" class="btn btn-success btn-sm">&check;</a>#}
{#                            </div>#}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </body>

    <script>
        $("form :input").each(function(index, elem) {
            var eId = $(elem).attr("id");
            var label = null;
            if (eId && (label = $(elem).parents("form").find("label[for="+eId+"]")).length == 1) {
                $(elem).attr("placeholder", $(label).html());
                $(label).remove();
            }
        });
    </script>
</html>
